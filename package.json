{
  "name": "unblocked-react-ssr",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist/server",
    "start": "node --env-file-if-exists=.env server/index.js --prod",
    "qa:visual": "node scripts/qa-visual.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "express": "latest",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "multer": "^2.4.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "playwright": "^1.58.0",
    "sass": "^1.105.1",
    "vite": "latest",
    "wrangler": "^4.152.0"
  }
}
