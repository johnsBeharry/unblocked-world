{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    { "source": "/api/forms/:path*", "destination": "/api/forms?__path=:path*" },
    { "source": "/posters", "destination": "/index.html" },
    { "source": "/guidelines", "destination": "/index.html" },
    { "source": "/grants", "destination": "/index.html" },
    { "source": "/grants/culture-grants", "destination": "/index.html" },
    { "source": "/grants/open-systems", "destination": "/index.html" },
    { "source": "/submit", "destination": "/index.html" },
    { "source": "/submit/form/consent", "destination": "/index.html" }
  ]
}
